{
  "name": "prajwal-prathiksh-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-sw.mjs",
    "preview": "astro preview",
    "signal:dev": "wrangler dev --ip 127.0.0.1 --port 8787 --var SITE_ORIGIN:http://127.0.0.1:4324",
    "check": "astro check",
    "signal:check": "tsc -p worker/tsconfig.json",
    "selfplay:smoke": "node scripts/run-chowka-tool.mjs smoke",
    "selfplay:benchmark": "node scripts/run-chowka-tool.mjs benchmark",
    "selfplay:train": "node scripts/run-chowka-tool.mjs train",
    "selfplay:tournament": "node scripts/run-chowka-tool.mjs tournament",
    "selfplay:baseline": "node scripts/run-chowka-tool.mjs baseline",
    "winmodel:train": "node scripts/run-chowka-tool.mjs win-train",
    "astro": "astro"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261002.1",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.147.0"
  }
}
