---
import '../styles/global.css';
import { person } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = `${person.name}: ${person.role}. Scientific ML, GPU computing, and numerical methods.`,
} = Astro.props;
const pageTitle = title ? `${title} · ${person.name}` : person.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Playroom" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="wrap site-header">
      <a href="/" class="brand">{person.name}</a>
      <nav aria-label="Main">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>About</a>
        <a href="/playroom/" aria-current={path.startsWith('/playroom') ? 'page' : undefined}>Playroom</a>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer muted">
      <p>© {new Date().getFullYear()} {person.name}. No cookies, no analytics. Works offline once installed.</p>
    </footer>
    <div id="update-notice" class="update-notice" role="status" hidden>
      <span>A new version is ready.</span>
      <button type="button" class="btn" id="update-reload">Refresh</button>
    </div>
    {
      import.meta.env.PROD && (
        <script>
          import { registerServiceWorker } from '../scripts/pwa';
          registerServiceWorker();
        </script>
      )
    }
  </body>
</html>

<style>
  .update-notice {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
    font-size: 0.9rem;
    translate: -50% 0;
  }

  .update-notice[hidden] {
    display: none;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .brand {
    color: var(--fg);
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
  }

  main {
    padding-bottom: 3rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 1.5rem 2.5rem;
    font-size: 0.85rem;
  }
</style>
