---
import Base from '../../layouts/Base.astro';
import Hand from '../../components/Hand.astro';

// Player 1 is the computer (top), player 0 is you (bottom). Index 0 is the
// hand on the left of the screen. Thumbs point toward the middle.
const sides = [
  { player: 1, name: 'Computer' },
  { player: 0, name: 'You' },
];
---

<Base title="Chopsticks" description="The finger-counting game Chopsticks, against the computer.">
  <p class="back"><a href="/play/">← All games</a></p>
  <h1>Chopsticks</h1>

  <div class="controls">
    <label>
      Mode
      <select id="mode">
        <option value="easy">Easy</option>
        <option value="hard">Hard</option>
      </select>
    </label>
    <button class="btn" type="button" id="reset">New game</button>
  </div>

  <div class="table">
    {
      sides.map(({ player, name }) => (
        <section class="side" data-side={player} aria-label={name}>
          <p class="name">{name}</p>
          <div class="hands">
            {[0, 1].map((i) => (
              <button type="button" class="hand" data-player={player} data-i={i}>
                <Hand mirrored={player === 0 ? i === 0 : i === 1} />
                <span class="count" />
              </button>
            ))}
          </div>
          {player === 0 && <div id="splits" class="splits" />}
        </section>
      ))
    }
  </div>

  <p id="status" class="status" aria-live="polite"></p>
  <p id="last" class="muted last"></p>

  <dl id="stats" class="stats"></dl>

  <details>
    <summary>How to play</summary>
    <p>You and the computer each start with one finger up on each hand. On your turn, attack or split.</p>
    <p>
      To attack, drag one of your hands onto one of the computer's, or tap yours and then theirs.
      Their hand gains as many fingers as yours shows. A hand that reaches exactly 5 is out. Past 5
      it wraps around, so 4 + 3 leaves 2.
    </p>
    <p>
      To split, use the buttons under your hands to move fingers between them, for example 1 · 3
      into 2 · 2. This can bring a dead hand back. If your total is 5 or more, you may drop five
      fingers, so 4 · 4 can become 0 · 3. Just swapping your hands doesn't count as a move.
    </p>
    <p>
      You lose when both your hands are out. If the same position comes up a third time, the game
      is a draw. With perfect play from the start, nobody can force a win.
    </p>
  </details>

  <p class="muted note">Scores are saved on this device only.</p>
</Base>

<script>
  import { apply, bestMove, isDead, key, legalMoves, type Hands, type Move } from '../../scripts/chopsticks';
  import { recordResult, renderRecord } from '../../scripts/scores';

  type Player = 0 | 1;
  type Side = 0 | 1;

  const YOU: Player = 0;
  const COMPUTER: Player = 1;
  const DELAY_MS = 800;
  const DRAG_THRESHOLD = 8;

  const modeEl = document.getElementById('mode') as HTMLSelectElement;
  const statusEl = document.getElementById('status')!;
  const lastEl = document.getElementById('last')!;
  const splitsEl = document.getElementById('splits')!;
  const statsEl = document.getElementById('stats')!;
  const handEl = (p: Player, i: Side) =>
    document.querySelector<HTMLButtonElement>(`.hand[data-player="${p}"][data-i="${i}"]`)!;

  let hands: [Hands, Hands];
  let turn: Player;
  let selected: Side | null;
  let over: boolean;
  let seen: Map<string, number>;
  let gameId = 0;

  const recordKey = () => `chopsticks-${modeEl.value}`;
  const yourTurn = () => !over && turn === YOU;

  const flash = (el: HTMLElement, cls: string) => {
    el.classList.remove(cls);
    void el.offsetWidth; // restart the animation
    el.classList.add(cls);
    el.addEventListener('animationend', () => el.classList.remove(cls), { once: true });
  };

  const render = () => {
    for (const p of [YOU, COMPUTER]) {
      for (const i of [0, 1] as const) {
        const el = handEl(p, i);
        const value = hands[p][i];
        el.querySelectorAll('.finger').forEach((f, n) => f.classList.toggle('up', n < value));
        el.querySelector('.count')!.textContent = String(value);
        el.classList.toggle('dead', value === 0);
        el.classList.toggle('selected', p === YOU && selected === i && yourTurn());
        el.classList.toggle('target', p === COMPUTER && selected !== null && value > 0 && yourTurn());
        el.disabled = !yourTurn() || value === 0 || (p === COMPUTER && selected === null);
        const side = p === YOU ? 'Your' : "Computer's";
        el.setAttribute('aria-label', `${side} ${i ? 'right' : 'left'} hand: ${value || 'out'}`);
        if (p === YOU) el.setAttribute('aria-pressed', String(selected === i));
      }
    }

    document.querySelectorAll<HTMLElement>('.side').forEach((side) => {
      side.classList.toggle('active', !over && Number(side.dataset.side) === turn);
    });

    splitsEl.innerHTML = '';
    const splits = yourTurn()
      ? legalMoves(hands[YOU], hands[COMPUTER]).filter((m) => m.kind === 'split')
      : [];
    if (splits.length) {
      const label = document.createElement('span');
      label.className = 'muted';
      label.textContent = 'Split into';
      splitsEl.append(label);
    }
    for (const move of splits) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn';
      btn.textContent = move.into.join(' · ');
      btn.setAttribute('aria-label', `Split into ${move.into.join(' and ')}`);
      btn.addEventListener('click', () => play(move));
      splitsEl.append(btn);
    }

    if (!over) {
      statusEl.textContent = !yourTurn()
        ? 'Computer is thinking…'
        : selected === null
          ? "Your turn. Drag a hand onto the computer's, or split."
          : 'Now tap the computer hand to hit.';
    }
    renderRecord(statsEl, recordKey());
  };

  const finish = (text: string, result: 'win' | 'loss' | 'draw') => {
    over = true;
    statusEl.textContent = text;
    recordResult(recordKey(), result);
  };

  function play(move: Move) {
    const opponent = (1 - turn) as Player;
    if (move.kind === 'attack') {
      const self = hands[turn][move.from];
      const target = hands[opponent][move.to];
      lastEl.textContent =
        turn === COMPUTER
          ? `Computer hit your ${target} with its ${self}.`
          : `You hit the computer's ${target} with your ${self}.`;
      flash(handEl(turn, move.from), turn === COMPUTER ? 'lunge-down' : 'lunge-up');
      flash(handEl(opponent, move.to), 'hit');
    } else {
      lastEl.textContent = `${turn === COMPUTER ? 'Computer' : 'You'} split into ${move.into.join(' · ')}.`;
    }

    const [mine, theirs] = apply(hands[turn], hands[opponent], move);
    hands[turn] = mine;
    hands[opponent] = theirs;
    selected = null;

    if (isDead(theirs)) {
      finish(turn === COMPUTER ? 'Computer wins.' : 'You win.', turn === COMPUTER ? 'loss' : 'win');
      render();
      return;
    }

    turn = opponent;
    const position = `${turn}:${key(hands[turn], hands[1 - turn])}`;
    const count = (seen.get(position) ?? 0) + 1;
    seen.set(position, count);
    if (count >= 3) finish('Draw: the same position came up three times.', 'draw');

    render();
    if (!over && turn === COMPUTER) {
      const id = gameId;
      setTimeout(() => {
        if (id !== gameId) return;
        play(bestMove(hands[COMPUTER], hands[YOU], modeEl.value === 'easy' ? 0.5 : 0));
      }, DELAY_MS);
    }
  }

  const attack = (from: Side, to: Side) => {
    if (yourTurn() && hands[YOU][from] > 0 && hands[COMPUTER][to] > 0) {
      play({ kind: 'attack', from, to });
    }
  };

  // Tap (or keyboard): select one of your hands, then a computer hand.
  let suppressClick = false;
  for (const i of [0, 1] as const) {
    handEl(YOU, i).addEventListener('click', () => {
      if (suppressClick) return;
      selected = selected === i ? null : i;
      render();
    });
    handEl(COMPUTER, i).addEventListener('click', () => {
      if (selected !== null) attack(selected, i);
    });
  }

  // Drag: pull one of your hands onto a computer hand.
  const targetAt = (x: number, y: number): Side | null => {
    for (const i of [0, 1] as const) {
      const r = handEl(COMPUTER, i).getBoundingClientRect();
      if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom && hands[COMPUTER][i] > 0) return i;
    }
    return null;
  };

  for (const i of [0, 1] as const) {
    const el = handEl(YOU, i);
    let start: { x: number; y: number; id: number } | null = null;
    let dragging = false;

    el.addEventListener('pointerdown', (e) => {
      if (!yourTurn() || hands[YOU][i] === 0) return;
      start = { x: e.clientX, y: e.clientY, id: e.pointerId };
      dragging = false;
      suppressClick = false;
      el.setPointerCapture(e.pointerId);
    });

    el.addEventListener('pointermove', (e) => {
      if (!start || e.pointerId !== start.id) return;
      const dx = e.clientX - start.x;
      const dy = e.clientY - start.y;
      if (!dragging && Math.hypot(dx, dy) < DRAG_THRESHOLD) return;
      if (!dragging) {
        dragging = true;
        selected = i;
        render();
        el.classList.add('dragging');
      }
      el.style.translate = `${dx}px ${dy}px`;
      const t = targetAt(e.clientX, e.clientY);
      for (const j of [0, 1] as const) handEl(COMPUTER, j).classList.toggle('over', t === j);
    });

    const end = (e: PointerEvent, commit: boolean) => {
      if (!start || e.pointerId !== start.id) return;
      start = null;
      el.classList.remove('dragging');
      el.style.translate = '';
      for (const j of [0, 1] as const) handEl(COMPUTER, j).classList.remove('over');
      if (!dragging) return;
      suppressClick = true; // the click that follows a drag is not a tap
      setTimeout(() => (suppressClick = false));
      const t = commit ? targetAt(e.clientX, e.clientY) : null;
      if (t !== null) {
        attack(i, t);
      } else {
        selected = null;
        render();
      }
    };
    el.addEventListener('pointerup', (e) => end(e, true));
    el.addEventListener('pointercancel', (e) => end(e, false));
  }

  const reset = () => {
    gameId++;
    hands = [
      [1, 1],
      [1, 1],
    ];
    turn = YOU;
    selected = null;
    over = false;
    seen = new Map([[`0:${key(hands[0], hands[1])}`, 1]]);
    lastEl.textContent = '';
    render();
  };

  document.getElementById('reset')!.addEventListener('click', reset);
  modeEl.addEventListener('change', reset);
  reset();
</script>

<style>
  .back {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  select {
    font: inherit;
    margin-left: 0.4rem;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg);
  }

  .table {
    --hand-fill: light-dark(#f4e7da, #2b3038);
    --hand-line: light-dark(#7a6452, #aeb6c0);
    --hand-up: light-dark(#f9d9b8, #3c4b5c);
    display: grid;
    gap: 1rem;
    width: min(100%, 26rem);
    margin-top: 1.5rem;
  }

  .side {
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    opacity: 0.8;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease;
  }

  .side.active {
    opacity: 1;
    border-color: var(--accent);
  }

  .name {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .hands {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .hand {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 0.75rem 0.5rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    transition:
      border-color 0.15s ease,
      opacity 0.2s ease;
  }

  .side[data-side='0'] .hand {
    touch-action: none; /* lets a finger drag the hand instead of scrolling */
  }

  .side[data-side='1'] .hand :global(.hand-svg) {
    rotate: 180deg;
  }

  .hand:disabled {
    cursor: default;
    color: var(--fg);
  }

  .hand:not(:disabled):hover,
  .hand.target {
    border-color: var(--accent);
  }

  .hand.selected,
  .hand.over {
    background: color-mix(in srgb, var(--accent) 18%, var(--surface));
    border-color: var(--accent);
  }

  .hand.dragging {
    z-index: 2;
    cursor: grabbing;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
  }

  .hand.dead {
    opacity: 0.4;
    border-style: dashed;
  }

  .count {
    font-size: 0.95rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .hand.hit {
    animation: hit 0.35s ease;
  }

  .hand.lunge-up {
    animation: lunge-up 0.3s ease;
  }

  .hand.lunge-down {
    animation: lunge-down 0.3s ease;
  }

  @keyframes hit {
    30% {
      scale: 0.92;
    }
  }

  @keyframes lunge-up {
    40% {
      translate: 0 -14px;
    }
  }

  @keyframes lunge-down {
    40% {
      translate: 0 14px;
    }
  }

  .splits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    min-height: 2.1rem;
    font-size: 0.9rem;
  }

  .status {
    min-height: 1.6em;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .last {
    min-height: 1.6em;
    margin-top: 0;
    font-size: 0.9rem;
  }

  details {
    margin-top: 2rem;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
  }

  .note {
    font-size: 0.85rem;
  }
</style>
