---
import Base from '../../layouts/Base.astro';
import { games } from '../../data/games';
---

<Base title="Play" description="Small browser games by Prajwal Prathiksh.">
  <h1>Play</h1>
  <p class="muted">Small games I build for fun. They run entirely in your browser.</p>

  <ul class="games">
    {
      games.map((g) => (
        <li>
          <a href={`/play/${g.slug}/`}>{g.name}</a>
          <span class="muted">{g.blurb}</span>
        </li>
      ))
    }
  </ul>

  <h2>Your data</h2>
  <p>
    High scores are saved in this browser's local storage on your device. Nothing is sent to a
    server, and the site sets no cookies and runs no analytics. Clearing your browser data removes
    them, or you can use the button below.
  </p>
  <p><button class="btn" type="button" id="clear">Clear saved scores</button></p>
</Base>

<script>
  import { clearAllScores } from '../../scripts/scores';

  const btn = document.getElementById('clear') as HTMLButtonElement;
  btn.addEventListener('click', () => {
    clearAllScores();
    btn.textContent = 'Cleared';
  });
</script>

<style>
  h1 {
    margin-top: 1.5rem;
  }

  .games {
    list-style: none;
    padding: 0;
  }

  .games li {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .games a {
    font-weight: 600;
  }
</style>
