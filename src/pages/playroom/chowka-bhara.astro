  .floor[data-board='7'] .cowrie:nth-child(3) { grid-column: 5 / 7; }
  .floor[data-board='7'] .cowrie:nth-child(4) { grid-area: 2 / 2 / 3 / 4; }
  .floor[data-board='7'] .cowrie:nth-child(5) { grid-area: 2 / 4 / 3 / 6; }
  .floor[data-board='7'] .cowrie:nth-child(6) { grid-area: 2 / 6 / 3 / 8; }

