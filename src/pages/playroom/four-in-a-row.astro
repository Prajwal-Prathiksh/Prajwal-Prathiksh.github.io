---
import Base from '../../layouts/Base.astro';
import ZenToggle from '../../components/ZenToggle.astro';

const COLS = 7;
const ROWS = 6;
// Front plate geometry, in a 700 x 600 viewBox: one 100-unit cell per slot.
const holes = Array.from({ length: COLS * ROWS }, (_, i) => ({ x: 50 + (i % COLS) * 100, y: 50 + Math.floor(i / COLS) * 100 }));
// Wood grain: long faint strokes, the same on every build.
let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const grain = Array.from({ length: 46 }, () => {
  const x = rand() * 700;
  const sway = (rand() - 0.5) * 18;
  return { d: `M${x.toFixed(1)} -5C${(x + sway).toFixed(1)} 180 ${(x - sway).toFixed(1)} 420 ${(x + sway * 0.6).toFixed(1)} 605`, w: (0.6 + rand() * 2.2).toFixed(2), o: (0.05 + rand() * 0.1).toFixed(3), light: rand() < 0.35 };
});
---

<Base title="Four in a Row" description="Four in a Row: drop brass and silver coins into a wooden rack and line up four. Play a friend or a computer that plays perfectly on Hard.">
  <p class="back"><a href="/playroom/">← Playroom</a></p>
  <h1>Four in a Row</h1>
  <p class="muted intro">Drop your coins into the rack and line up four.</p>

  <svg class="sprite" aria-hidden="true">
    <defs>
      <symbol id="mark-sun" viewBox="-20 -20 40 40">
        <circle r="6.2" fill="none" stroke="currentColor" stroke-width="2.4" />
        <g stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          {Array.from({ length: 8 }, (_, i) => (
            <line x1="0" y1="-10" x2="0" y2="-14.5" transform={`rotate(${i * 45})`} />
          ))}
        </g>
      </symbol>
      <symbol id="mark-moon" viewBox="-20 -20 40 40">
        <path d="M5.5 -11.5a12 12 0 1 0 6 16.5a9.5 9.5 0 1 1 -6 -16.5z" fill="currentColor" />
        <circle cx="8.5" cy="-6" r="1.6" fill="currentColor" />
      </symbol>
    </defs>
  </svg>

  <div class="game-area" data-zen>
    <form id="setup" class="setup">
      <fieldset>
        <legend>Opponent</legend>
        <div class="chips">
          <label class="chip"><input type="radio" name="opponent" value="computer" checked />Computer</label>
          <label class="chip"><input type="radio" name="opponent" value="friend" />A friend, on this device</label>
        </div>
      </fieldset>
      <fieldset id="level-set">
        <legend>Computer</legend>
        <div class="chips">
          <label class="chip"><input type="radio" name="level" value="easy" />Easy</label>
          <label class="chip"><input type="radio" name="level" value="medium" checked />Medium</label>
          <label class="chip"><input type="radio" name="level" value="hard" />Hard</label>
        </div>
        <p id="level-hint" class="hint muted"></p>
      </fieldset>
      <fieldset>
        <legend id="coin-legend">Your coins</legend>
        <div class="chips">
          <label class="chip"><input type="radio" name="coin" value="brass" checked /><span class="chip-coin brass" aria-hidden="true"><svg><use href="#mark-sun" /></svg></span>Brass</label>
          <label class="chip"><input type="radio" name="coin" value="silver" /><span class="chip-coin silver" aria-hidden="true"><svg><use href="#mark-moon" /></svg></span>Silver</label>
        </div>
      </fieldset>
      <fieldset id="first-set">
        <legend>First move</legend>
        <div class="chips">
          <label class="chip"><input type="radio" name="first" value="you" checked />You</label>
          <label class="chip"><input type="radio" name="first" value="computer" />Computer</label>
          <label class="chip"><input type="radio" name="first" value="alternate" />Take turns</label>
        </div>
      </fieldset>
      <div class="setup-actions">
        <button type="submit" class="btn primary">Start game</button>
        <ZenToggle />
      </div>
    </form>

    <div id="matchbar" class="matchbar" hidden>
      <span id="summary" class="muted"></span>
      <button type="button" class="btn" id="hint">Hint</button>
      <button type="button" class="btn" id="coach" aria-pressed="false" title="Show threats, odd and even rows, and how each column turns out">Coach</button>
      <button type="button" class="btn" id="undo">Undo</button>
      <button type="button" class="btn" id="newgame">New game</button>
      <ZenToggle />
    </div>

    <div class="play">
      <p class="status" aria-live="polite">
        <span id="status-coin" class="status-coin" aria-hidden="true"><svg><use href="#mark-sun" /></svg></span>
        <span id="status"></span>
      </p>

      <div class="board" id="board">
        <div class="lane" aria-hidden="true">
          <div id="ghost" class="coin ghost" hidden><span class="face"><svg><use href="#mark-sun" /></svg></span></div>
        </div>
        <div class="rack">
          <div class="well" id="well">
            <div class="hollow"></div>
            <div id="coins" class="coins"></div>
            <svg class="plate" viewBox="0 0 700 600" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="plate-wood" x1="0" y1="0" x2="1" y2="0.15">
                  <stop offset="0" stop-color="#7a421f" />
                  <stop offset="0.35" stop-color="#94532b" />
                  <stop offset="0.6" stop-color="#7c4521" />
                  <stop offset="0.85" stop-color="#98582e" />
                  <stop offset="1" stop-color="#74401d" />
                </linearGradient>
                <linearGradient id="plate-rim" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#1e0a02" stop-opacity="0.8" />
                  <stop offset="1" stop-color="#ffd9a0" stop-opacity="0.35" />
                </linearGradient>
                <mask id="plate-holes" maskUnits="userSpaceOnUse" x="0" y="0" width="700" height="600">
                  <rect width="700" height="600" fill="#fff" />
                  {holes.map((h) => <circle cx={h.x} cy={h.y} r="39" fill="#000" />)}
                </mask>
              </defs>
              <g mask="url(#plate-holes)">
                <rect width="700" height="600" fill="url(#plate-wood)" />
                {grain.map((g) => <path d={g.d} fill="none" stroke={g.light ? '#ffe2b8' : '#2a1005'} stroke-width={g.w} opacity={g.o} />)}
                {holes.map((h) => <circle cx={h.x} cy={h.y} r="41.5" fill="none" stroke="url(#plate-rim)" stroke-width="5" />)}
              </g>
            </svg>
            <svg id="win-line" class="win-line" viewBox="0 0 700 600" aria-hidden="true"></svg>
            <svg id="coach-marks" class="coach-marks" viewBox="0 0 700 600" aria-hidden="true"></svg>
          </div>
          <span class="foot left" aria-hidden="true"></span>
          <span class="foot right" aria-hidden="true"></span>
        </div>
        <div class="cols" id="cols" role="group" aria-label="Columns">
          {Array.from({ length: COLS }, (_, c) => (
            <button type="button" class="col" data-col={c} aria-label={`Drop a coin in column ${c + 1}`} />
          ))}
        </div>
      </div>
      <div id="verdicts" class="verdicts" role="group" aria-label="How each column turns out" hidden>
        {Array.from({ length: COLS }, (_, c) => (
          <button type="button" class="verdict" data-col={c}><span class="v-col">{'abcdefg'[c]}</span><span class="v-text"></span></button>
        ))}
      </div>
      <p id="insight" class="insight muted"></p>

      <section id="coach-panel" class="coach-panel" hidden aria-label="Coach">
        <div class="thumb-row">
          <p id="thumb" class="thumb"></p>
          <label class="switch"><input type="checkbox" id="show-counts" checked /><span></span>Line counts</label>
        </div>
        <div id="coach-notes" class="coach-notes" aria-live="polite"></div>

        <div id="line-box" class="line-box" hidden>
          <div class="line-head">
            <strong id="line-title"></strong>
            <div class="line-controls">
              <button type="button" class="btn small" id="line-prev" aria-label="One move back">◀</button>
              <span id="line-step" class="muted"></span>
              <button type="button" class="btn small" id="line-next" aria-label="One move forward">▶</button>
              <button type="button" class="btn small" id="line-close">Close</button>
            </div>
          </div>
          <p id="line-sub" class="muted line-sub"></p>
          <ol id="line-steps" class="line-steps"></ol>
          <div id="branch" class="branch" hidden>
            <p id="branch-title" class="muted"></p>
            <div id="branch-chips" class="verdicts inline"></div>
          </div>
        </div>

        <details class="coach-legend">
          <summary>How to read the coach</summary>
          <ul>
            <li><b>Rows 1–6</b> are numbered from the bottom. Odd rows suit whoever went first, even rows whoever went second: as the rack fills up, that is how the squares fall.</li>
            <li><span class="key ring good"></span> A solid ring is a <b>threat on a good row</b> for its owner: a square that completes four and that its owner will usually get to fill.</li>
            <li><span class="key ring"></span> A dashed ring is a threat on the owner's bad row. Useful for forcing moves, rarely a winner on its own.</li>
            <li><span class="key cross"></span> Don't play here: it fills the square right under the other side's threat, so they win on top.</li>
            <li><span class="key cross waste"></span> Playing here lets the other side block one of your own threats.</li>
            <li><b>The glowing numbers</b> count the lines of four still open through each hole: lines that don't already hold coins of both sides. The brighter the glow, the more lines. The holes your next coin can reach are shown large.</li>
            <li><span class="key star">★</span> <b>Rule of thumb:</b> win if you can, block if you must, never fill the hole under a threat, then take the hole with the most open lines, with a bonus for making a trapdoor on your own floor. It's what a strong human does without calculating. The coach then tells you whether perfect play agrees.</li>
            <li>Under the rack, every column shows how the game ends if the player to move goes there and both sides then play perfectly: <b>Win in 3</b> means three more of your coins, whatever they do. Tap one to watch that game play out, then tap any step to try a different move there.</li>
            <li>In the first few moves the browser can't prove every result yet, so some columns show <b>?</b> and early steps of a line are marked as estimates.</li>
          </ul>
        </details>
      </section>
    </div>
  </div>

  <dl id="stats" class="stats"></dl>
  <p class="muted note">Results against the computer are saved on this device only.</p>

  <section class="rules">
    <h2>How to play</h2>
    <p>
      Take turns dropping a coin into one of the seven columns. It falls to the lowest empty
      slot. The first to line up four of their own coins in a row, across, up and down or on a
      slant, wins. If the rack fills with no line of four, the game is a draw.
    </p>
    <p>
      Brass coins carry a sun and silver coins a moon, so the two are easy to tell apart. On a
      keyboard, use the arrow keys to pick a column and Enter to drop. Stuck? <em>Hint</em> asks the
      Hard computer for your best column and tells you whether it wins by force, holds a draw,
      or just looks strongest.
    </p>
    <p>
      Hard never misses. The game is solved: whoever moves first can always win by starting in the
      middle column. When Hard goes first it plays a proven winning move every turn, from a small
      book of solved openings and then from its own search. When you go first, a perfect game
      beats it, but one slip is usually enough for it to take over.
    </p>
  </section>
</Base>

<script>
  import { recordResult, renderRecord } from '../../scripts/scores';
  import { chooseMove, type Choice, type Level } from '../../scripts/fourInARowAI';
  import { Solver } from '../../scripts/fourInARow';
  import type { MoveRequest, MoveResponse } from '../../scripts/fourInARow.worker';
  import type { CoachRequest, CoachResponse, Verdict } from '../../scripts/fourInARowCoach.worker';
  import { gridOf, openLines, review, ruleOfThumb, square, threats, warnings, colName, type ThumbPick } from '../../scripts/fourInARowCoach';

  const W = 7;
  const H = 6;
  type Coin = 'brass' | 'silver';
  type Who = { coin: Coin; computer: boolean; name: string };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const setupEl = $<HTMLFormElement>('setup');
  const matchbarEl = $('matchbar');
  const summaryEl = $('summary');
  const statusEl = $('status');
  const statusCoinEl = $('status-coin');
  const insightEl = $('insight');
  const coinsEl = $('coins');
  const ghostEl = $('ghost');
  const laneEl = document.querySelector<HTMLElement>('.lane')!;
  const lineEl = $('win-line');
  const boardEl = $('board');
  const undoEl = $<HTMLButtonElement>('undo');
  const hintEl = $<HTMLButtonElement>('hint');
  const statsEl = $('stats');
  const colEls = [...document.querySelectorAll<HTMLButtonElement>('.col')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const LEVEL_HINTS: Record<Level, string> = {
    easy: 'Looks a move or two ahead and sometimes misses things.',
    medium: 'Looks several moves ahead. A fair fight.',
    hard: 'Plays perfectly. If it moves first, it cannot be beaten.',
  };

  // ---- Game state ----
  let seq: number[] = [];
  let players: [Who, Who] = [
    { coin: 'brass', computer: false, name: 'You' },
    { coin: 'silver', computer: true, name: 'Computer' },
  ];
  let level: Level = 'medium';
  let vsComputer = true;
  let over = false;
  let thinking = false;
  let started = false;
  let gameId = 0;
  let alternateNext: 'you' | 'computer' = 'you';
  let hover: number | null = null;
  let lastProof: number | null = null;
  let hintCol: number | null = null;
  let hintsUsed = 0;
  let hinting = false;

  const toMove = () => players[seq.length % 2];
  const heights = () => {
    const h = Array(W).fill(0);
    seq.forEach((c) => h[c]++);
    return h;
  };
  // owner[c][r]: 0 or 1 for the player who placed it, -1 empty.
  const owners = () => {
    const grid = Array.from({ length: W }, () => Array(H).fill(-1));
    const h = Array(W).fill(0);
    seq.forEach((c, i) => { grid[c][h[c]++] = i % 2; });
    return grid;
  };

  function fourAt(grid: number[][], c: number, r: number): [number, number][] | null {
    const who = grid[c][r];
    for (const [dc, dr] of [[1, 0], [0, 1], [1, 1], [1, -1]]) {
      const cells: [number, number][] = [[c, r]];
      for (const sign of [1, -1]) {
        let x = c + dc * sign;
        let y = r + dr * sign;
        while (x >= 0 && x < W && y >= 0 && y < H && grid[x][y] === who) {
          cells.push([x, y]);
          x += dc * sign;
          y += dr * sign;
        }
      }
      if (cells.length >= 4) {
        cells.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
        // Keep the four (or more) in line order for drawing.
        return dc === 0 ? cells.sort((a, b) => a[1] - b[1]) : cells;
      }
    }
    return null;
  }

  // ---- Drawing ----
  const markFor = (coin: Coin) => (coin === 'brass' ? '#mark-sun' : '#mark-moon');
  const coinHtml = (coin: Coin) => `<span class="face"><svg><use href="${markFor(coin)}"/></svg></span>`;

  function placeCoin(c: number, r: number, coin: Coin): HTMLElement {
    const el = document.createElement('div');
    el.className = `coin ${coin}`;
    el.style.setProperty('--c', String(c));
    el.style.setProperty('--r', String(r));
    el.dataset.cell = `${c}-${r}`;
    el.innerHTML = coinHtml(coin);
    coinsEl.append(el);
    return el;
  }

  function redrawCoins() {
    coinsEl.innerHTML = '';
    const grid = owners();
    grid.forEach((col, c) => col.forEach((who, r) => { if (who >= 0) placeCoin(c, r, players[who].coin); }));
  }

  function setCoinIcon(el: HTMLElement, coin: Coin) {
    el.className = el.className.replace(/\b(brass|silver)\b/g, '').trim() + ` ${coin}`;
    el.querySelector('use')!.setAttribute('href', markFor(coin));
  }

  async function dropAnimation(el: HTMLElement, r: number) {
    if (reducedMotion.matches) return;
    const cell = el.getBoundingClientRect().height;
    // From the waiting spot in the lane down to its slot.
    const fall = el.getBoundingClientRect().top - laneEl.getBoundingClientRect().top;
    const ms = 170 + Math.sqrt(H - r) * 120;
    const bounce = Math.min(cell * 0.18, 10);
    await el.animate(
      [
        { transform: `translateY(${-fall}px)`, easing: 'cubic-bezier(0.55, 0, 1, 0.45)' },
        { transform: 'translateY(0)', offset: 0.7, easing: 'cubic-bezier(0, 0.55, 0.45, 1)' },
        { transform: `translateY(${-bounce}px)`, offset: 0.85, easing: 'cubic-bezier(0.55, 0, 1, 0.45)' },
        { transform: 'translateY(0)' },
      ],
      { duration: ms },
    ).finished;
  }

  function drawWin(cells: [number, number][]) {
    const set = new Set(cells.map(([c, r]) => `${c}-${r}`));
    coinsEl.querySelectorAll<HTMLElement>('.coin').forEach((el) => {
      el.classList.toggle('win', set.has(el.dataset.cell!));
      el.classList.toggle('dim', !set.has(el.dataset.cell!));
    });
    const [a, b] = [cells[0], cells[cells.length - 1]];
    const x = (c: number) => 50 + c * 100;
    const y = (r: number) => 550 - r * 100;
    lineEl.innerHTML = `<line x1="${x(a[0])}" y1="${y(a[1])}" x2="${x(b[0])}" y2="${y(b[1])}" pathLength="1"/>`;
  }

  function clearWin() {
    lineEl.innerHTML = '';
  }

  function renderGhost() {
    const who = toMove();
    const at = hover ?? hintCol;
    const show = started && !over && !thinking && at !== null && !who.computer && heights()[at] < H;
    ghostEl.hidden = !show;
    if (show) {
      ghostEl.style.setProperty('--c', String(at));
      setCoinIcon(ghostEl, who.coin);
    }
  }

  function render() {
    const h = heights();
    const who = toMove();
    const humanTurn = started && !over && !thinking && !who.computer;
    colEls.forEach((el, c) => {
      el.disabled = !humanTurn || h[c] >= H;
      el.classList.toggle('hinted', humanTurn && c === hintCol);
    });
    hintEl.disabled = !humanTurn || hinting;
    boardEl.classList.toggle('live', humanTurn);
    renderGhost();
    if (!over) setCoinIcon(statusCoinEl, who.coin);
    const humanMoves = seq.filter((_, i) => !players[i % 2].computer).length;
    undoEl.disabled = thinking || seq.length === 0 || (vsComputer && humanMoves === 0);
    renderRecord(statsEl, vsComputer ? `four-in-a-row-${level}` : null);
    coachUpdate();
  }

  function setStatus(text: string, coin?: Coin) {
    statusEl.textContent = text;
    if (coin) setCoinIcon(statusCoinEl, coin);
  }

  function turnStatus() {
    const who = toMove();
    if (vsComputer) {
      setStatus(who.computer ? 'Computer is thinking…' : seq.length < 2 ? 'Your move. Tap a column.' : 'Your move.', who.coin);
    } else {
      setStatus(`${who.name}'s move.`, who.coin);
    }
    statusEl.parentElement!.classList.toggle('thinking', who.computer);
    insightEl.textContent = level === 'hard' && vsComputer && lastProof === 1 && !over
      ? 'Hard has found a forced win.'
      : '';
  }

  // ---- The computer, in a worker so the page never stalls ----
  let worker: Worker | null = null;
  let requestId = 0;
  const pending = new Map<number, (choice: Choice) => void>();
  let fallbackSolver: Solver | null = null;

  function askComputer(as: Level = level): Promise<Choice> {
    const request: MoveRequest = { id: ++requestId, seq: [...seq], level: as };
    try {
      if (!worker) {
        worker = new Worker(new URL('../../scripts/fourInARow.worker.ts', import.meta.url), { type: 'module' });
        worker.onmessage = (event: MessageEvent<MoveResponse>) => {
          pending.get(event.data.id)?.(event.data);
          pending.delete(event.data.id);
        };
        worker.onerror = () => {
          worker?.terminate();
          worker = null;
          pending.forEach((resolve) => resolve(onPage(as)));
          pending.clear();
        };
      }
      worker.postMessage(request);
      return new Promise((resolve) => pending.set(request.id, resolve));
    } catch {
      return Promise.resolve(onPage(as));
    }
  }

  // Without workers the page thinks for itself, more briefly.
  function onPage(as: Level): Choice {
    fallbackSolver ??= new Solver();
    return chooseMove(seq, as, fallbackSolver, { thinkMs: 1200 });
  }

  // ---- Hints: the Hard computer's choice for whoever is to move ----
  const HINT_NOTES: Record<string, (col: number) => string> = {
    win: (c) => `Column ${c} wins by force from here.`,
    draw: (c) => `Column ${c} holds the draw. Nothing here wins by force.`,
    lose: (c) => `Every move loses against perfect play. Column ${c} holds out longest.`,
    search: (c) => `Column ${c} looks strongest.`,
  };

  function clearHint() {
    hintCol = null;
    if (!over) insightEl.textContent = '';
  }

  async function askHint() {
    if (hinting || over || thinking || toMove().computer) return;
    const id = gameId;
    const asked = seq.length;
    hinting = true;
    hintEl.textContent = 'Thinking…';
    render();
    const choice = await askComputer('hard');
    hinting = false;
    hintEl.textContent = 'Hint';
    if (id !== gameId || seq.length !== asked) return render();
    hintCol = choice.col;
    hover = null; // the waiting coin moves to the hinted column
    hintsUsed++;
    const kind = choice.proof === 1 ? 'win' : choice.proof === 0 ? 'draw' : choice.proof === -1 ? 'lose' : 'search';
    insightEl.textContent = HINT_NOTES[kind](choice.col + 1);
    updateSummary();
    render();
    if (document.activeElement === hintEl) colEls[choice.col].focus({ preventScroll: true });
  }

  function updateSummary() {
    const hints = hintsUsed ? ` · ${hintsUsed} ${hintsUsed === 1 ? 'hint' : 'hints'}` : '';
    summaryEl.textContent = (vsComputer
      ? `${level[0].toUpperCase()}${level.slice(1)} computer · ${players[0].computer ? 'computer starts' : 'you start'}`
      : 'Two players') + hints;
  }

  async function computerTurn() {
    const id = gameId;
    thinking = true;
    render();
    turnStatus();
    const startedAt = performance.now();
    const choice = await askComputer();
    // A short pause so an instant reply still reads as a move.
    const wait = 450 - (performance.now() - startedAt);
    if (wait > 0) await new Promise((r) => setTimeout(r, wait));
    if (id !== gameId) return;
    thinking = false;
    lastProof = choice.proof;
    await drop(choice.col);
  }

  // ---- Moves ----
  async function drop(c: number) {
    const h = heights();
    if (over || h[c] >= H) return;
    const id = gameId;
    const who = toMove();
    clearHint();
    if (coachOn) {
      noteMove([...seq], c);
      line = null;
      branchAt = null;
    }
    seq.push(c);
    const r = h[c];
    const el = placeCoin(c, r, who.coin);
    thinking = true; // no input while the coin falls
    render();
    await dropAnimation(el, r);
    if (id !== gameId) return;
    thinking = false;
    const four = fourAt(owners(), c, r);
    if (four) return finish(seq.length % 2 === 1 ? 0 : 1, four);
    if (seq.length === W * H) return finish(null, null);
    turnStatus();
    render();
    if (toMove().computer) computerTurn();
  }

  function finish(winner: 0 | 1 | null, four: [number, number][] | null) {
    over = true;
    if (four) drawWin(four);
    const who = winner === null ? null : players[winner];
    if (vsComputer) {
      setStatus(!who ? 'Draw. The rack is full.' : who.computer ? 'Computer wins.' : 'You win!', who?.coin ?? toMove().coin);
      recordResult(`four-in-a-row-${level}`, !who ? 'draw' : who.computer ? 'loss' : 'win');
    } else {
      setStatus(!who ? 'Draw. The rack is full.' : `${who.name} wins!`, who?.coin ?? toMove().coin);
    }
    statusEl.parentElement!.classList.remove('thinking');
    insightEl.textContent = '';
    boardEl.classList.toggle('won', Boolean(four));
    render();
  }

  function undo() {
    if (thinking || !seq.length) return;
    gameId++;
    resetCoach();
    hinting = false;
    hintEl.textContent = 'Hint';
    clearHint();
    over = false;
    boardEl.classList.remove('won');
    clearWin();
    // Against the computer, step back to your previous turn.
    do seq.pop();
    while (vsComputer && seq.length && toMove().computer);
    if (vsComputer && toMove().computer) {
      redrawCoins();
      computerTurn();
      return;
    }
    lastProof = null;
    redrawCoins();
    turnStatus();
    render();
  }


  // ---- Coach ----
  // Marks threats and odd/even rows on the rack, shows how every column turns
  // out under perfect play, plays out the rest of the game for any column, and
  // comments on each move. Its solver runs in a worker of its own.
  const coachEl = $<HTMLButtonElement>('coach');
  const coachPanelEl = $('coach-panel');
  const coachNotesEl = $('coach-notes');
  const marksEl = $('coach-marks');
  const verdictsEl = $('verdicts');
  const verdictEls = [...verdictsEl.querySelectorAll<HTMLButtonElement>('.verdict')];
  const lineBoxEl = $('line-box');
  const lineStepsEl = $('line-steps');
  const branchEl = $('branch');
  const branchChipsEl = $('branch-chips');
  const COIN_COLOUR: Record<Coin, string> = { brass: '#f0c75a', silver: '#e3e8ee' };

  let coachOn = false;
  let showCounts = true;
  const showCountsEl = $<HTMLInputElement>('show-counts');
  const thumbEl = $('thumb');
  let coachWorker: Worker | null = null;
  let coachBusy = false;
  let coachId = 0;
  const coachHandlers = new Map<number, (response: CoachResponse) => void>();
  // Verdicts by position (the move sequence joined), so a position is solved once.
  const verdictCache = new Map<string, (Verdict | null)[]>();
  const verdictDone = new Set<string>();
  let coachNotes: { who: string; notes: string[] }[] = [];
  interface Line { base: number[]; moves: number[]; guessed: boolean[]; end: 'win' | 'draw' | 'open' | 'pending' }
  let line: Line | null = null;
  let lineStep = 0;
  let branchAt: number | null = null;

  const keyOf = (moves: readonly number[]) => moves.join('');

  type CoachAsk = { kind: 'verdicts'; seq: number[] } | { kind: 'line'; seq: number[]; col: number };
  // What the worker is busy with, so a repeat of the same question is not resent.
  let coachAsking = '';

  function askCoach(request: CoachAsk, onMessage: (response: CoachResponse) => void) {
    const asking = `${request.kind}:${keyOf(request.seq)}:${request.kind === 'line' ? request.col : ''}`;
    if (coachBusy && asking === coachAsking) return;
    coachAsking = asking;
    // A newer question replaces an unfinished one: the worker is restarted.
    if (coachBusy && coachWorker) {
      coachWorker.terminate();
      coachWorker = null;
      coachHandlers.clear();
    }
    if (!coachWorker) {
      coachWorker = new Worker(new URL('../../scripts/fourInARowCoach.worker.ts', import.meta.url), { type: 'module' });
      coachWorker.onmessage = (event: MessageEvent<CoachResponse>) => {
        const { id, kind } = event.data;
        if ((kind === 'line' || kind === 'verdicts-done') && id === coachId) coachBusy = false;
        coachHandlers.get(id)?.(event.data);
        if (kind === 'line' || kind === 'verdicts-done') coachHandlers.delete(id);
      };
    }
    const id = ++coachId;
    coachHandlers.set(id, onMessage);
    coachBusy = true;
    coachWorker.postMessage({ id, ...request } as CoachRequest);
  }

  function requestVerdicts(moves: number[], then?: () => void) {
    const key = keyOf(moves);
    if (verdictDone.has(key)) { then?.(); return; }
    if (!verdictCache.has(key)) verdictCache.set(key, Array(W).fill(null));
    askCoach({ kind: 'verdicts', seq: moves }, (response) => {
      if (response.kind === 'verdict') verdictCache.get(key)![response.verdict.col] = response.verdict;
      if (response.kind === 'verdicts-done') verdictDone.add(key);
      then?.();
      renderCoach();
    });
  }

  // "Win in 3": the mover needs three more coins. "Lose in 5": the other side wins with its fifth coin from now.
  function verdictText(v: Verdict | null | undefined, moves: readonly number[]): { text: string; title: string; cls: string } {
    if (!v) return { text: '…', title: 'Working it out', cls: 'pending' };
    if (v.outcome === null) return { text: '?', title: 'Too early to prove in the browser. Play a few more coins.', cls: 'unknown' };
    const mover = moves.length % 2;
    const mine = moves.filter((_, i) => i % 2 === mover).length;
    const theirs = moves.length - mine;
    const known = v.source === 'theory' ? ' (known result)' : v.source === 'book' ? ' (opening book)' : '';
    if (v.outcome === 0) return { text: 'Draw', title: `Perfect play from both sides ends in a draw${known}.`, cls: 'draw' };
    if (v.outcome > 0) {
      const n = v.score === null ? null : 22 - v.score - mine;
      return {
        text: n === null ? 'Win' : n === 1 ? 'Wins now' : `Win in ${n}`,
        title: n === null ? `Wins against any defence${known}.` : `Wins with the ${ordinal(n)} coin from now, whatever the other side does.`,
        cls: 'win',
      };
    }
    const n = v.score === null ? null : 22 + v.score - theirs;
    return {
      text: n === null ? 'Lose' : `Lose in ${n}`,
      title: n === null ? `Loses against perfect play${known}.` : `Against perfect play the other side wins with its ${ordinal(n)} coin from now.`,
      cls: 'lose',
    };
  }

  const ordinal = (n: number) => `${n}${n % 10 === 1 && n !== 11 ? 'st' : n % 10 === 2 && n !== 12 ? 'nd' : n % 10 === 3 && n !== 13 ? 'rd' : 'th'}`;

  // Who the coach is talking to: in a computer game, only your own turns.
  const coachTurn = () => coachOn && started && !over && !thinking && !toMove().computer;

  function fillVerdicts(container: HTMLElement, buttons: HTMLButtonElement[], moves: number[], active: boolean) {
    const verdicts = verdictCache.get(keyOf(moves)) ?? [];
    const { heights } = gridOf(moves);
    const ranked = verdicts.filter((v): v is Verdict => !!v && v.outcome !== null);
    const best = ranked.length ? Math.max(...ranked.map((v) => v.outcome! * 100 + (v.score ?? 0))) : null;
    buttons.forEach((el, c) => {
      const full = heights[c] >= H;
      const v = verdicts[c];
      const { text, title, cls } = full ? { text: '', title: 'Full', cls: 'full' } : verdictText(v, moves);
      el.className = `verdict ${cls}`;
      el.classList.toggle('best', !!v && v.outcome !== null && v.outcome * 100 + (v.score ?? 0) === best);
      el.disabled = full || !active;
      el.title = title;
      el.querySelector('.v-text')!.textContent = text;
    });
    container.hidden = false;
  }

  function placements(base: readonly number[], moves: readonly number[]) {
    const { heights } = gridOf(base);
    return moves.map((c, i) => ({ c, r: heights[c]++, player: (base.length + i) % 2 }));
  }

  function renderMarks() {
    const parts: string[] = [];
    const x = (c: number) => 50 + c * 100;
    const y = (r: number) => 550 - r * 100;
    // Row numbers in the rack's left edge: odd rows in brass, even in silver.
    for (let r = 0; r < H; r++) {
      parts.push(`<text class="row-no ${r % 2 ? 'even' : 'odd'}" x="-27" y="${y(r) + 8}">${r + 1}</text>`);
    }
    const shown = line ? [...line.base, ...line.moves.slice(0, lineStep)] : seq;
    const { grid, heights } = gridOf(shown);
    // Open-line counts: a warm glow in every empty hole, brighter on more
    // lines, with the number large in the holes the next coin can reach.
    const pick = !line && coachTurn() ? ruleOfThumb(grid, heights, seq.length % 2) : null;
    if (showCounts && !line && coachTurn()) {
      parts.push('<defs><radialGradient id="heat"><stop offset="0" stop-color="#ffc56b" stop-opacity="0.95"/><stop offset="0.55" stop-color="#ff9a3c" stop-opacity="0.45"/><stop offset="1" stop-color="#ff7a1a" stop-opacity="0"/></radialGradient></defs>');
      for (let c = 0; c < W; c++) {
        for (let r = heights[c]; r < H; r++) {
          const { open } = openLines(grid, c, r, seq.length % 2);
          const reach = r === heights[c];
          const glow = (reach ? 0.18 : 0.06) + (open / 13) * (reach ? 0.82 : 0.32);
          if (open) parts.push(`<circle cx="${x(c)}" cy="${y(r)}" r="40" fill="url(#heat)" opacity="${glow.toFixed(2)}"/>`);
          parts.push(`<text class="count ${reach ? 'reach' : ''}" x="${x(c)}" y="${y(r) + (reach ? 11 : 8)}">${open}</text>`);
        }
      }
    }
    if (pick) {
      parts.push(`<circle class="thumb-ring" cx="${x(pick.col)}" cy="${y(pick.r)}" r="45"/>`);
      parts.push(`<text class="thumb-star" x="${x(pick.col) + 30}" y="${y(pick.r) - 24}">★</text>`);
    }
    const all = threats(grid, heights);
    const seen = new Map<string, number>();
    for (const t of all) {
      const k = `${t.c},${t.r}`;
      const inner = seen.get(k) ?? 0;
      seen.set(k, inner + 1);
      parts.push(`<circle class="threat ${t.good ? 'good' : ''}" cx="${x(t.c)}" cy="${y(t.r)}" r="${36 - inner * 11}" stroke="${COIN_COLOUR[players[t.player].coin]}"/>`);
    }
    if (!line && coachTurn()) {
      for (const w of warnings(grid, heights, seq.length % 2)) {
        const cx = x(w.c);
        const cy = y(w.r);
        parts.push(`<g class="cross ${w.kind}"><line x1="${cx - 17}" y1="${cy - 17}" x2="${cx + 17}" y2="${cy + 17}"/><line x1="${cx + 17}" y1="${cy - 17}" x2="${cx - 17}" y2="${cy + 17}"/></g>`);
      }
    }
    if (line) {
      const placed = placements(line.base, line.moves).slice(0, lineStep);
      placed.forEach(({ c, r, player }, i) => {
        const last = i === placed.length - 1;
        parts.push(`<g class="future ${last ? 'last' : ''}"><circle cx="${x(c)}" cy="${y(r)}" r="37" fill="${COIN_COLOUR[players[player].coin]}"/><text x="${x(c)}" y="${y(r) + 11}">${i + 1}</text></g>`);
      });
      if (line.end === 'win' && lineStep === line.moves.length && placed.length) {
        const end = placed[placed.length - 1];
        const four = fourAt(gridOf(shown).grid, end.c, end.r);
        if (four) {
          const [a, b] = [four[0], four[four.length - 1]];
          parts.push(`<line class="future-four" x1="${x(a[0])}" y1="${y(a[1])}" x2="${x(b[0])}" y2="${y(b[1])}"/>`);
        }
      }
    }
    marksEl.innerHTML = parts.join('');
  }

  function renderLine() {
    lineBoxEl.hidden = !line;
    if (!line) return;
    const names = [players[0].name, players[1].name];
    const firstMover = line.base.length % 2;
    const first = line.moves[0];
    if (line.end === 'pending') {
      $('line-title').textContent = `${names[firstMover]} in column ${colName(first)}…`;
      $('line-sub').textContent = 'Working out the best play from both sides.';
    } else {
      const placed = placements(line.base, line.moves);
      const lastPlayer = placed.at(-1)!.player;
      $('line-title').textContent = `${names[firstMover]} in column ${colName(first)}`;
      $('line-sub').textContent = line.end === 'win'
        ? `Best play from both sides: ${names[lastPlayer]} completes four on coin ${line.moves.length} of this line.`
        : line.end === 'draw' ? 'Best play from both sides fills the rack: a draw.'
        : 'The line stops here: it took too long to work out the rest.';
    }
    $('line-step').textContent = `${lineStep} / ${line.moves.length}`;
    $<HTMLButtonElement>('line-prev').disabled = lineStep === 0;
    $<HTMLButtonElement>('line-next').disabled = lineStep >= line.moves.length;
    const placed = placements(line.base, line.moves);
    lineStepsEl.innerHTML = placed.map(({ c, r, player }, i) =>
      `<li><button type="button" class="step ${i < lineStep ? 'shown' : ''} ${i === lineStep - 1 ? 'current' : ''} ${i === branchAt ? 'branching' : ''}" data-step="${i}" style="--coin:${COIN_COLOUR[players[player].coin]}">`
      + `<span class="dot"></span>${i + 1}. ${names[player]}: ${square(c, r)}${line!.guessed[i] ? ' <em>estimate</em>' : ''}</button></li>`).join('');
    branchEl.hidden = branchAt === null;
    if (branchAt !== null) {
      const at = [...line.base, ...line.moves.slice(0, branchAt)];
      const name = names[at.length % 2];
      $('branch-title').textContent = `What if ${name === 'You' ? 'you play' : `${name} plays`} somewhere else at step ${branchAt + 1}? Tap a column to follow that game instead.`;
      if (!branchChipsEl.children.length) {
        branchChipsEl.innerHTML = verdictEls.map((el) => el.outerHTML).join('');
      }
      fillVerdicts(branchEl, [...branchChipsEl.querySelectorAll<HTMLButtonElement>('.verdict')], at, true);
    }
  }

  function renderNotes() {
    coachNotesEl.innerHTML = coachNotes.length
      ? coachNotes.map(({ who, notes }) => `<p><b>${who}:</b> ${notes.join(' ')}</p>`).join('')
      : '<p class="muted">Notes on each move appear here as you play.</p>';
  }

  function renderCoach() {
    coachEl.setAttribute('aria-pressed', String(coachOn));
    coachEl.classList.toggle('on', coachOn);
    coachPanelEl.hidden = !coachOn || !started;
    boardEl.classList.toggle('coaching', coachOn);
    if (!coachOn) {
      marksEl.innerHTML = '';
      verdictsEl.hidden = true;
      return;
    }
    renderMarks();
    if (coachTurn() || line) fillVerdicts(verdictsEl, verdictEls, seq, coachTurn());
    else verdictsEl.hidden = true;
    renderLine();
    renderNotes();
    renderThumb();
  }

  // The rule of thumb's choice, and whether perfect play agrees with it.
  function renderThumb() {
    const { grid, heights } = gridOf(seq);
    const pick: ThumbPick | null = coachTurn() ? ruleOfThumb(grid, heights, seq.length % 2) : null;
    thumbEl.hidden = !pick;
    if (!pick) return;
    const where = `column ${colName(pick.col)}`;
    let text = pick.why === 'win' ? `<b>★ Rule of thumb:</b> ${where} wins right now.`
      : pick.why === 'block' ? `<b>★ Rule of thumb:</b> block in ${where}, or they win next move.`
      : `<b>★ Rule of thumb:</b> ${where}, ${pick.open} open lines through ${square(pick.col, pick.r)}${pick.trapdoors ? `, and it makes a trapdoor on your floor` : ''}.`;
    if (pick.avoided.length) text += ` Skips ${pick.avoided.map(colName).join(' and ')}: ${pick.avoided.length > 1 ? 'they open' : 'it opens'} a trapdoor for the other side.`;
    const verdicts = verdictCache.get(keyOf(seq)) ?? [];
    const mine = verdicts[pick.col];
    const known = verdicts.filter((v): v is Verdict => !!v && v.outcome !== null);
    const rank = (v: Verdict) => v.outcome! * 100 + (v.score ?? 0);
    if (!mine) text += ' <span class="muted">Checking it against perfect play…</span>';
    else if (mine.outcome === null) text += ' <span class="muted">Too early for the solver to check.</span>';
    else {
      const best = known.reduce((a, b) => (rank(b) > rank(a) ? b : a), mine);
      const label = (v: Verdict) => verdictText(v, seq).text;
      if (best === mine || rank(best) === rank(mine)) text += ` <span class="agree">Perfect play agrees: ${label(mine)}.</span>`;
      else if (best.outcome === mine.outcome) text += ` <span class="agree">Good enough: ${label(mine)}. Column ${colName(best.col)} is quicker (${label(best)}).</span>`;
      else text += ` <span class="disagree">Perfect play disagrees: this is ${label(mine)}, but column ${colName(best.col)} is ${label(best)}.</span>`;
    }
    thumbEl.innerHTML = text;
  }

  // Ask for verdicts on your turn, or follow up a finished line's branch.
  function coachUpdate() {
    if (coachTurn() && !line) requestVerdicts([...seq]);
    renderCoach();
  }

  function openLine(base: number[], prefix: number[], guessedPrefix: boolean[], col: number) {
    line = { base, moves: [...prefix, col], guessed: [...guessedPrefix, false], end: 'pending' };
    lineStep = prefix.length + 1;
    branchAt = null;
    renderCoach();
    askCoach({ kind: 'line', seq: [...base, ...prefix], col }, (response) => {
      if (response.kind !== 'line' || !line) return;
      line = { base, moves: [...prefix, ...response.line], guessed: [...guessedPrefix, ...response.guessed], end: response.end };
      renderCoach();
    });
  }

  function resetCoach() {
    line = null;
    lineStep = 0;
    branchAt = null;
    coachNotes = [];
  }

  function closeLine() {
    line = null;
    lineStep = 0;
    branchAt = null;
    branchChipsEl.innerHTML = '';
    coachUpdate();
  }

  // Notes on a move just made, with how it compared to the best available.
  function noteMove(before: number[], col: number) {
    if (!coachOn) return;
    const names: [string, string] = [players[0].name, players[1].name];
    const notes = review(before, col, names);
    const verdicts = verdictCache.get(keyOf(before));
    const played = verdicts?.[col];
    const known = verdicts?.filter((v): v is Verdict => !!v && v.outcome !== null) ?? [];
    if (played && played.outcome !== null && known.length) {
      const top = known.reduce((a, b) => (b.outcome! > a.outcome! ? b : a));
      const word = (o: number) => (o > 0 ? 'win' : o < 0 ? 'loss' : 'draw');
      if (top.outcome! > played.outcome) {
        notes.push(`That turned a ${word(top.outcome!)} into a ${word(played.outcome)}: column ${colName(top.col)} was the way to go.`);
      } else if (played.outcome > 0) {
        notes.push('Still a forced win.');
      }
    }
    const { heights } = gridOf(before);
    const who = `${players[before.length % 2].name}, ${square(col, heights[col])}`;
    coachNotes = [{ who, notes: notes.length ? notes : ['A quiet move: no threat made, blocked or missed.'] }, ...coachNotes].slice(0, 2);
  }

  showCountsEl.addEventListener('change', () => { showCounts = showCountsEl.checked; renderCoach(); });
  coachEl.addEventListener('click', () => {
    coachOn = !coachOn;
    if (!coachOn) { line = null; branchAt = null; }
    coachUpdate();
  });
  verdictEls.forEach((el, c) => el.addEventListener('click', () => {
    if (!coachTurn()) return;
    openLine([...seq], [], [], c);
  }));
  branchChipsEl.addEventListener('click', (event) => {
    const el = (event.target as HTMLElement).closest<HTMLButtonElement>('.verdict');
    if (!el || !line || branchAt === null || el.disabled) return;
    const at = branchAt;
    openLine(line.base, line.moves.slice(0, at), line.guessed.slice(0, at), Number(el.dataset.col));
  });
  lineStepsEl.addEventListener('click', (event) => {
    const el = (event.target as HTMLElement).closest<HTMLButtonElement>('.step');
    if (!el || !line || line.end === 'pending') return;
    const i = Number(el.dataset.step);
    lineStep = i + 1;
    branchAt = i;
    branchChipsEl.innerHTML = '';
    requestVerdicts([...line.base, ...line.moves.slice(0, i)]);
    renderCoach();
  });
  $('line-prev').addEventListener('click', () => { if (line && lineStep > 0) { lineStep--; renderCoach(); } });
  $('line-next').addEventListener('click', () => { if (line && lineStep < line.moves.length) { lineStep++; renderCoach(); } });
  $('line-close').addEventListener('click', closeLine);

  // ---- Setup ----
  function readSetup() {
    const f = new FormData(setupEl);
    vsComputer = f.get('opponent') === 'computer';
    level = f.get('level') as Level;
    const coin = f.get('coin') as Coin;
    const other: Coin = coin === 'brass' ? 'silver' : 'brass';
    $('level-set').hidden = !vsComputer;
    $('first-set').hidden = !vsComputer;
    $('coin-legend').textContent = vsComputer ? 'Your coins' : 'First player';
    $('level-hint').textContent = LEVEL_HINTS[level];
    if (!vsComputer) {
      players = [
        { coin, computer: false, name: coin === 'brass' ? 'Brass' : 'Silver' },
        { coin: other, computer: false, name: other === 'brass' ? 'Brass' : 'Silver' },
      ];
      return;
    }
    const first = f.get('first') as 'you' | 'computer' | 'alternate';
    const computerFirst = first === 'computer' || (first === 'alternate' && alternateNext === 'computer');
    const you: Who = { coin, computer: false, name: 'You' };
    const cpu: Who = { coin: other, computer: true, name: 'Computer' };
    players = computerFirst ? [cpu, you] : [you, cpu];
  }

  function newGame() {
    gameId++;
    resetCoach();
    readSetup();
    seq = [];
    over = false;
    thinking = false;
    lastProof = null;
    hintCol = null;
    hintsUsed = 0;
    hinting = false;
    hintEl.textContent = 'Hint';
    boardEl.classList.remove('won');
    clearWin();
    redrawCoins();
    updateSummary();
    if (vsComputer && new FormData(setupEl).get('first') === 'alternate') {
      alternateNext = players[0].computer ? 'you' : 'computer';
    }
    turnStatus();
    render();
    if (toMove().computer) computerTurn();
  }

  setupEl.addEventListener('change', () => { if (!started) { readSetup(); render(); } });
  setupEl.addEventListener('submit', (event) => {
    event.preventDefault();
    started = true;
    setupEl.hidden = true;
    matchbarEl.hidden = false;
    newGame();
  });
  $('newgame').addEventListener('click', () => {
    started = false;
    gameId++;
    thinking = false;
    setupEl.hidden = false;
    matchbarEl.hidden = true;
    setupEl.querySelector<HTMLButtonElement>('button[type=submit]')!.focus();
    seq = [];
    over = false;
    boardEl.classList.remove('won');
    clearWin();
    redrawCoins();
    readSetup();
    setStatus('Choose your game and press Start.');
    statusEl.parentElement!.classList.remove('thinking');
    insightEl.textContent = '';
    render();
  });
  undoEl.addEventListener('click', undo);
  hintEl.addEventListener('click', askHint);

  colEls.forEach((el, c) => {
    el.addEventListener('pointerenter', () => { hover = c; renderGhost(); });
    el.addEventListener('focus', () => { hover = c; renderGhost(); });
    el.addEventListener('click', () => { hover = c; drop(c); });
    el.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : 0;
      if (!step) return;
      event.preventDefault();
      for (let next = c + step; next >= 0 && next < W; next += step) {
        if (!colEls[next].disabled) { colEls[next].focus(); break; }
      }
    });
  });
  $('cols').addEventListener('pointerleave', () => { hover = null; renderGhost(); });

  readSetup();
  setStatus('Choose your game and press Start.', players[0].coin);
  render();
</script>

<style>
  .back {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  h1 {
    margin-bottom: 0.25rem;
  }

  .intro {
    margin-top: 0;
  }

  .sprite {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* ---- Setup, in the playroom's chip style ---- */
  .setup {
    display: grid;
    gap: 0.9rem;
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .setup[hidden],
  .matchbar[hidden],
