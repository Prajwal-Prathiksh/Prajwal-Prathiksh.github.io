---
import Base from '../../layouts/Base.astro';
import CowrieSprite from '../../components/CowrieSprite.astro';
import GameThumb from '../../components/GameThumb.astro';
import InstallGuide from '../../components/InstallGuide.astro';
import { games } from '../../data/games';
---

<Base wide title="Playroom" description="Small games by Prajwal Prathiksh: heritage board games from Karnataka, puzzles and word games. They run in your browser and work offline.">
  <h1>Playroom</h1>
  <p class="muted intro">Small games I build for fun, from childhood board games to puzzles. They run entirely in your browser.</p>

  <CowrieSprite />
  <ul class="cards">
    {
      games.map((g) => (
        <li>
          <a class="card" href={`/playroom/${g.slug}/`}>
            <span class="art">
              <GameThumb slug={g.slug} />
            </span>
            <span class="body">
              <span class="name">{g.name}</span>
              <span class="meta">{g.meta}</span>
              <span class="blurb muted">{g.blurb}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="playroom-details">
    <InstallGuide />

    <section class="data">
      <h2>Your data</h2>
      <p>
        High scores are saved in this browser's local storage on your device. Nothing is sent to a
        server, and the site sets no cookies and runs no analytics. Clearing your browser data removes
        them, or you can use the button below.
      </p>
      <p><button class="btn" type="button" id="clear">Clear saved scores</button></p>
    </section>
  </div>
</Base>

<script>
  import { clearAllScores } from '../../scripts/scores';

  const btn = document.getElementById('clear') as HTMLButtonElement;
  btn.addEventListener('click', () => {
    clearAllScores();
    btn.textContent = 'Cleared';
  });
</script>

<style>
  h1 {
    margin-top: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .intro {
    margin-top: 0;
    max-width: var(--measure);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
    transition:
      translate 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .card:hover,
  .card:focus-visible {
    translate: 0 -3px;
    border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.25);
  }

  .art {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #111;
  }

  .art :global(.thumb) {
    transition: scale 0.35s ease;
  }

  .card:hover .art :global(.thumb) {
    scale: 1.04;
  }

  .body {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    padding: 0.8rem 0.95rem 1rem;
  }

  .name {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .meta {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .blurb {
    font-size: 0.92rem;
    line-height: 1.45;
  }

  @media (min-width: 70rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .playroom-details {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }

    .data h2 {
      margin-top: 3rem;
    }
  }
</style>
