.hint-tools {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 0.6rem 1rem;
  margin: -0.5rem 0 1rem;
  min-height: 40px;
}
#hint-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 40px;
  padding: 0.5rem 0.85rem;
  border: 1px solid #d8b577;
  border-radius: 30px;
  background: #fff7df;
  color: var(--plum);
  font-size: 0.75rem;
  font-weight: 700;
}
#hint-toggle[aria-pressed="true"] {
  background: #4c1733;
  border-color: #4c1733;
  color: #fff3d7;
}
.hint-switch {
  width: 18px;
  height: 18px;
  border: 1.5px dashed currentColor;
  border-radius: 50%;
}
#hint-status {
  color: #806148;
  font-size: 0.72rem;
}
.hint-rings {
  pointer-events: none;
}
.hint-ring {
  fill: none;
  stroke: #b2436d;
  stroke-width: 2.5px;
  stroke-dasharray: 5 3;
  paint-order: stroke;
  filter: drop-shadow(0 0 2px #fff) drop-shadow(0 0 2px #fff);
  animation: hint-appear 0.4s ease both;
  transform-box: fill-box;
  transform-origin: center;
}
.revealed-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.3rem;
  margin: 0 auto 0.85rem;
  animation: feedback-rise 0.35s ease both;
}
.revealed-brand > span {
  font-size: 0.58rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #916331;
}
.revealed-brand strong {
  display: block;
  border: 1px solid #dcc495;
  border-radius: 30px;
  background: #fff0cf;
  padding: 0.5rem 1.2rem;
  color: var(--plum);
  font-size: 1rem;
  font-weight: 750;
}
@keyframes hint-appear {
  from {
    opacity: 0;
    scale: 1.12;
  }
  to {
    opacity: 1;
    scale: 1;
  }
}
