}
.zoom-choice:hover {
  border-color: var(--plum);
}
.confetti {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}
.confetti i {
  position: absolute;
  left: var(--x);
  top: -20px;
  width: 8px;
  height: 13px;
  background: var(--c);
  animation: fall 2.5s ease-in var(--delay) both;
}
.logo-party.zen-on {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: 0;
  min-height: 100dvh;
  padding: 0 max(0px, env(safe-area-inset-right)) env(safe-area-inset-bottom)
    max(0px, env(safe-area-inset-left));
  border: 0;
  border-radius: 0;
  background: #fff8ea;
}
.logo-party.zen-on .party-bar {
  position: sticky;
  top: 0;
  padding-top: max(2rem, env(safe-area-inset-top));
  padding-right: 6.5rem;
  background: #fff8eaf7;
  flex-shrink: 0;
}
.logo-party.zen-on .zen-open {
  display: none;
}
.logo-party.zen-on .zen-exit {
  position: fixed;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  top: max(1.6rem, env(safe-area-inset-top));
  right: max(1rem, env(safe-area-inset-right));
  width: auto;
  min-height: 44px;
  padding: 0.6rem 1rem;
  border: 1px solid #d9c2a4;
  border-radius: 9px;
  background: #fff7e8;
  color: var(--plum);
  font-size: 0.8rem;
  font-weight: 700;
}
.logo-party.zen-on .party-content {
  flex: 1;
  width: 100%;
  max-width: 1250px;
  padding-top: 0.3rem;
}
.logo-party.zen-on .logo-canvas {
  height: clamp(180px, 36dvh, 420px);
}
.logo-party.zen-on #theme-control {
  display: none;
}
.logo-party.zen-on .party-footer {
  flex-shrink: 0;
}
.logo-party.zen-on .setup {
  padding-top: 2dvh;
}
@keyframes float {
  50% {
    transform: translateY(-7px);
  }
}
@keyframes flicker {
  50% {
    scale: 0.88 1.08;
    rotate: -19deg;
  }
}
@keyframes fall {
  to {
    transform: translateY(110vh) rotate(640deg);
    opacity: 0;
  }
}
@keyframes card-celebrate {
  0%,
  100% {
    transform: scale(1);
  }
  35% {
    transform: translateY(-7px) scale(1.025);
  }
  65% {
    transform: translateY(1px) scale(0.99);
  }
}
@keyframes card-shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-5px) rotate(-1deg);
  }
  40% {
    transform: translateX(4px) rotate(1deg);
  }
  60% {
    transform: translateX(-2px);
  }
}
@keyframes logo-pop {
  0%,
  100% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.05);
  }
  70% {
    transform: scale(0.98);
  }
}
@keyframes stamp-pop {
  0% {
    transform: scale(0) rotate(-35deg);
    opacity: 0;
  }
  55% {
    transform: scale(1.2) rotate(8deg);
    opacity: 1;
  }
  80% {
    transform: scale(0.95);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
@keyframes feedback-rise {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
