---
import Base from '../../layouts/Base.astro';
---
<Base wide title="Logo Lagaan" description="Spot the real logo. A Diwali party game with Indian favourites and familiar international brands, with three choices per round.">
  <p class="back"><a href="/playroom/">← Playroom</a></p>
  <div class="logo-party" data-zen>
    <div class="garland" aria-hidden="true">{Array.from({length: 17}, (_, i) => <i style={`--i:${i}`} />)}</div>
    <header class="party-bar">
      <a class="party-wordmark" href="/playroom/logo-lagaan/">✦ LOGO LAGAAN</a>
      <button type="button" class="zen-open fullscreen-button" data-zen-open aria-label="Full screen">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        Full screen
      </button>
      <button type="button" class="zen-exit" data-zen-exit aria-label="Exit full screen">✕ <span>Exit</span></button>
    </header>
    <div class="party-content">
      <section id="setup" class="setup">
        <div class="intro-art" aria-hidden="true">
          <div class="rangoli">{Array.from({length: 12}, (_, i) => <i style={`--angle:${i * 30}deg`} />)}<span>?</span></div>
          <span class="floating float-a">A</span><span class="floating float-b">B</span><span class="floating float-c">C</span><span class="spark s1">✧</span><span class="spark s2">✦</span>
        </div>
        <h1>Spot the<br /><em>real one.</em></h1>
        <p class="lede">Three versions. One original.</p>
        <form id="setup-form" class="setup-panel">
          <div class="setup-fields">
            <label>Players<select id="play-mode"><option value="solo">Solo</option><option value="party">Party</option></select></label>
          </div>
          <div id="team-setup" hidden>
            <label>Teams<select id="team-count"><option value="2">2 teams</option><option value="3">3 teams</option><option value="4">4 teams</option><option value="5">5 teams</option><option value="6">6 teams</option></select></label>
            <div id="team-name-fields" class="team-name-fields"></div>
            <p class="scoring-note"><b>3 pts</b> before hints <span>·</span> <b>1 pt</b> with hints </p>
          </div>
          <button class="primary start" type="submit">Play <span aria-hidden="true">↗</span></button>
        </form>
      </section>
      <section id="round" hidden aria-label="Logo round">
        <div class="round-meta"><span id="round-number"></span><span id="score"></span><button id="restart" class="text-button" type="button">New game</button></div>
        <div id="scoreboard" class="party-scoreboard" role="region" aria-label="Team score race" hidden></div><span id="score-announcement" class="sr-only" role="status"></span>
        <div id="progress" class="progress" role="progressbar" aria-label="Rounds completed" aria-valuemin="0" aria-valuenow="0"><i></i></div>
        <div class="round-workspace">
        <div class="round-stage">
        <div class="question"><p class="eyebrow">WHICH IS REAL?</p><h2 id="brand-name" tabindex="-1"></h2><button id="zoom-open" type="button" class="zoom-open" aria-label="Enlarge the three images"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5M10 7v6M7 10h6"/></svg></button></div>
        <div class="hint-tools"><button id="hint-toggle" type="button" aria-pressed="false" aria-describedby="hint-status"><span aria-hidden="true">✧</span> Hint <span class="hint-switch" aria-hidden="true"></span></button><span id="hint-status" class="sr-only" role="status"></span></div>
        <div class="choices" role="group" aria-label="Choose the original logo">
          <button class="logo-choice" id="choice-a" type="button" aria-pressed="false"><span class="choice-top"><b>A</b><span class="choice-state"></span></span><span class="logo-canvas" id="logo-a"></span><span class="result-stamp" aria-hidden="true"></span></button>
          <button class="logo-choice" id="choice-b" type="button" aria-pressed="false"><span class="choice-top"><b>B</b><span class="choice-state"></span></span><span class="logo-canvas" id="logo-b"></span><span class="result-stamp" aria-hidden="true"></span></button>
          <button class="logo-choice" id="choice-c" type="button" aria-pressed="false"><span class="choice-top"><b>C</b><span class="choice-state"></span></span><span class="logo-canvas" id="logo-c"></span><span class="result-stamp" aria-hidden="true"></span></button>
        </div>
        </div>
        <div class="round-sidebar">
        <section id="party-controls" class="party-controls" aria-label="Lock team answers" hidden>
          <div class="lock-heading"><div><h3>Team picks</h3><p id="team-lock-status" role="status"></p></div></div>
          <div id="team-answers" class="team-answers"></div>
        </section>
        <div class="answer-area">
          <div id="revealed-brand" class="revealed-brand" hidden><strong id="revealed-brand-name"></strong></div>
          <div id="feedback" role="status" aria-live="polite"></div>
          <details id="reveal-detail" class="reveal-detail" hidden><summary>What changed?</summary><p id="difference"></p><a id="round-source" href="/logos/logo-lagaan/SOURCES.txt" target="_blank" rel="noopener noreferrer">Reference</a></details>
          <button id="reveal" class="primary" type="button" disabled>Reveal <span aria-hidden="true">✦</span></button>
          <button id="next" class="primary" type="button" hidden>Next <span aria-hidden="true">→</span></button>
        </div>
        </div>
        </div>
      </section>
      <section id="results" class="results" hidden>
        <div class="result-medal" aria-hidden="true">✦</div><h2 id="result-title" tabindex="-1"></h2><p id="result-copy" class="lede"></p><div id="final-scores" class="final-scores"></div><button id="play-again" type="button" class="primary">Play again <span aria-hidden="true">↗</span></button><details class="review"><summary>See the differences</summary><div id="answer-review"></div></details>
      </section>
    </div>
    <footer class="party-footer"><span class="diya" aria-hidden="true"><i></i></span><span>Happy Diwali</span><span class="diya" aria-hidden="true"><i></i></span></footer>
    <dialog id="art-zoom" aria-labelledby="zoom-title">
      <div class="zoom-bar"><h2 id="zoom-title"></h2><button id="zoom-close" type="button" aria-label="Close enlarged images">✕</button></div>
      <div id="zoom-options"></div>
    </dialog>
    <div id="confetti" class="confetti" aria-hidden="true"></div>
  </div>
  <details class="credits"><summary>Artwork & sources</summary><p>14 Indian references and six international favourites. Original comparison artwork is reused where available; custom variations are recreated from cited reference designs. Choose the version that matches that reference. <a href="/logos/logo-lagaan/SOURCES.txt">Sources and artwork credits</a>. Trademarks belong to their owners.</p></details>
</Base>
<script>
  import '../../scripts/logoLagaan';
  import { setupZen } from '../../scripts/zen';
  setupZen();
</script>
<style is:global>
.logo-party {
  --ink: #382324;
  --plum: #4c1733;
  --pink: #c53c64;
  position: relative;
  isolation: isolate;
  overflow: hidden;
  margin: 1rem 0 2rem;
  border: 1px solid #e8d5ba;
  border-radius: 22px;
  background: #fff8ea;
  color: var(--ink);
  color-scheme: light;
  box-shadow: 0 18px 65px #401b1710;
  font-family: ui-sans-serif, system-ui, sans-serif;
}
.logo-party * {
  box-sizing: border-box;
}
.logo-party [hidden] {
  display: none !important;
}
.logo-party button,
.logo-party select,
.logo-party input {
  font-family: inherit;
}
.logo-party button {
  cursor: pointer;
}
.logo-party :is(button, select, input, a):focus-visible {
  outline: 3px solid #ae3562;
  outline-offset: 4px;
}
.logo-party button:disabled {
  cursor: default;
}
.party-bar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 2.5rem 1.5rem 1rem;
}
.party-wordmark {
  font-size: 0.8rem;
  font-weight: 850;
  letter-spacing: 0.12em;
  color: var(--plum);
  text-decoration: none;
}
.logo-party .fullscreen-button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 44px;
  padding: 0.65rem 1rem;
  background: var(--plum);
  color: #fff4de;
  border: 1px solid var(--plum);
  border-radius: 9px;
  font-size: 0.8rem;
  font-weight: 700;
  box-shadow: 0 3px 0 #2c0f22;
}
.logo-party .fullscreen-button svg {
  width: 1em;
  height: 1em;
}
.logo-party .zen-exit {
  display: none;
}
.party-content {
  width: min(100%, 1120px);
  margin: auto;
  padding: 0 2rem 1.4rem;
}
.setup {
  text-align: center;
  padding-bottom: 2rem;
}
.logo-party h1 {
  font-family: Georgia, serif;
  font-weight: 400;
  font-size: clamp(3rem, 6vw, 5rem);
  line-height: 1.02;
  letter-spacing: -0.055em;
  color: var(--plum);
  margin: 0.8rem 0 1rem;
}
.logo-party h1 em {
  color: #bd3e56;
}
.lede {
  color: #7b6258;
  line-height: 1.6;
  font-size: 1rem;
}
.intro-art {
  width: 200px;
  height: 165px;
  margin: 0 auto;
  position: relative;
}
.rangoli {
  position: absolute;
  inset: 18px 35px;
  display: grid;
  place-items: center;
  border: 1px solid #d6aa6260;
  border-radius: 50%;
  animation: float 7s ease-in-out infinite;
}
.rangoli i {
  position: absolute;
  inset: 17px 49px;
  border: 1px solid #d79a4560;
  border-radius: 50%;
  transform: rotate(var(--angle));
  background: #f6af3a0a;
}
.rangoli span {
  position: relative;
  font-family: Georgia, serif;
  font-size: 4rem;
  font-style: italic;
  color: var(--plum);
}
.floating {
  position: absolute;
  display: grid;
  place-items: center;
  width: 38px;
  height: 46px;
  border: 1px solid #e4c8a9;
  border-radius: 8px;
  font:
    1.5rem Georgia,
    serif;
  box-shadow: 0 4px 0 #eacda9;
  animation: float 5s ease-in-out infinite;
}
.float-a {
  left: 3px;
  top: 26px;
  rotate: -16deg;
  background: #ffe4ba;
  color: #af542e;
}
.float-b {
  right: 3px;
  top: 26px;
  rotate: 14deg;
  background: #f4d9e4;
  color: #89344f;
  animation-delay: -2s;
}
.float-c {
  bottom: 0;
  left: 81px;
  rotate: -5deg;
  background: #e6edda;
  color: #507041;
  animation-delay: -1s;
}
.spark {
  position: absolute;
  color: #b67c29;
}
.s1 {
  left: 20px;
  bottom: 15px;
  font-size: 2rem;
}
.s2 {
  right: 10px;
  top: 5px;
  font-size: 1.5rem;
}
.setup-panel {
  max-width: 650px;
  margin: 1.5rem auto 0;
  padding: 1.2rem;
  background: #fffdf7;
  border: 1px solid #e7d6bf;
  border-radius: 14px;
  text-align: left;
}
.setup-fields {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.8rem;
}
.logo-party label {
  display: grid;
  gap: 0.45rem;
  font-size: 0.72rem;
  font-weight: 750;
  color: #785347;
}
.logo-party select,
.logo-party input {
  width: 100%;
  min-height: 44px;
  padding: 0.55rem 0.45rem;
  border: 1px solid #ddcbb4;
  background: #fffaf0;
  border-radius: 6px;
  color: var(--ink);
  font-size: 0.8rem;
}
.field-hint {
  font-weight: 400;
}
#team-setup {
  margin-top: 1rem;
}
.primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  min-height: 48px;
  padding: 0.8rem 1.5rem;
  border: 1px solid var(--plum);
  border-radius: 8px;
  background: var(--plum);
  color: #fff4de;
  font-size: 0.9rem;
  font-weight: 700;
  box-shadow: 0 4px 0 #2c0f22;
  transition:
    transform 0.18s,
    background 0.18s;
}
.primary:hover {
  background: #6c2448;
  transform: translateY(-2px);
}
.primary:disabled {
  opacity: 0.45;
  transform: none;
}
.start {
  width: 100%;
  margin-top: 1rem;
  justify-content: space-between;
}
.garland {
  display: flex;
  justify-content: space-around;
  position: absolute;
  top: -17px;
  left: -1%;
  width: 102%;
  height: 40px;
  border-bottom: 1px solid #aa7d4d;
  border-radius: 0 0 50% 50%;
  pointer-events: none;
}
.garland i {
  position: relative;
  top: calc(15px + sin(var(--i) * 11deg) * 10px);
  height: 24px;
  width: 15px;
  border-radius: 40%;
  background: repeating-linear-gradient(
    0deg,
    #f7aa27 0px,
    #f7aa27 3px,
    #e78a1c 4px,
    #e78a1c 5px
  );
}
.garland i:nth-child(3n) {
  background: #a14854;
}
.party-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.3rem;
  padding: 1.5rem 1rem;
  border-top: 1px solid #ead8ba;
  color: #8b6448;
  font:
    0.85rem Georgia,
    serif;
  font-style: italic;
}
.diya {
  position: relative;
  display: block;
  width: 28px;
  height: 12px;
  border-radius: 3px 3px 20px 20px;
  background: #b65137;
  border-top: 3px solid #df893d;
}
.diya i {
  position: absolute;
  width: 9px;
  height: 17px;
  left: 10px;
  top: -20px;
  border-radius: 85% 10% 65% 30%;
  background: #ffbe40;
  box-shadow: 0 0 15px #ffad3c90;
  rotate: -25deg;
  animation: flicker 2s ease-in-out infinite;
}
.round-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.75rem;
  color: #7e5d4f;
  margin-top: 0.5rem;
}
.round-meta #score {
  margin-left: auto;
  font-weight: 750;
  color: var(--plum);
}
.text-button {
  background: none;
  border: 0;
  text-decoration: underline;
  color: #795a4d;
  min-height: 44px;
  padding: 0.5rem 0;
  font-size: 0.75rem;
}
.progress {
  height: 4px;
  background: #eadcc8;
  border-radius: 9px;
  margin: 0.5rem 0 1.1rem;
  overflow: hidden;
}
.progress i {
  display: block;
  height: 100%;
  width: 0;
  background: #bd3e56;
  transition: width 0.4s;
}
.question {
  position: relative;
  text-align: center;
  margin: 0.8rem 0 1.4rem;
  padding-inline: 3rem;
}
.eyebrow {
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 0.17em;
  color: #a14c3a;
  margin: 0.5rem 0;
}
.question h2,
.results h2 {
  font:
    400 clamp(1.8rem, 3.6vw, 3.1rem)/1.12 Georgia,
    serif;
  letter-spacing: -0.04em;
  color: var(--plum);
  margin: 0.2rem 0;
}
.zoom-open {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid #dac5ae;
  border-radius: 50%;
  background: #fffaf0;
  color: var(--plum);
}
.zoom-open svg {
  width: 22px;
  height: 22px;
  stroke: currentColor;
  stroke-width: 1.6;
  fill: none;
}
.choices {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}
.logo-choice {
  position: relative;
  min-width: 0;
  padding: 0.85rem;
  border: 2px solid #e6d6be;
  border-radius: 14px;
  background: #fffdf8;
  color: #765849;
  text-align: left;
  transition:
    transform 0.2s,
    border-color 0.2s,
    box-shadow 0.2s;
}
.logo-choice:not(:disabled):hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 0 #eadbc7;
}
.logo-choice[aria-pressed="true"] {
  border-color: var(--plum);
  box-shadow: 0 0 0 3px #4c173312;
}
.choice-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.3rem;
  min-height: 32px;
}
.choice-top b {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border: 1px solid #ddc9ae;
  border-radius: 50%;
  font-size: 1rem;
  color: var(--plum);
}
.choice-state {
  font-size: 0.67rem;
  font-weight: 700;
}
.logo-canvas {
  display: grid;
  place-items: center;
  height: clamp(160px, 30dvh, 300px);
  padding: 0.65rem 0 0;
  overflow: hidden;
}
.memory-art {
  display: block;
  width: 100%;
  height: 100%;
  max-width: 100%;
  overflow: hidden;
}
.result-stamp {
  position: absolute;
  right: 0.8rem;
  bottom: 0.8rem;
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 1.4rem;
  font-weight: 800;
  opacity: 0;
  pointer-events: none;
}
.logo-choice[data-result="correct"] {
  border-color: #4b8057;
  background: #f5fbf0;
  box-shadow:
    0 0 0 3px #4b80571a,
    0 12px 30px #4b805718;
  animation: card-celebrate 650ms cubic-bezier(0.2, 0.8, 0.3, 1) both;
}
.logo-choice[data-result="incorrect"] {
  border-color: #c36868;
  background: #fff8f4;
  animation: card-shake 480ms ease both;
}
.logo-choice[data-result="correct"] .logo-canvas {
  animation: logo-pop 650ms cubic-bezier(0.2, 0.8, 0.3, 1);
}
.logo-choice[data-result] .result-stamp {
  opacity: 1;
  animation: stamp-pop 600ms cubic-bezier(0.2, 0.8, 0.3, 1) both;
}
.logo-choice[data-result="correct"] .result-stamp {
  background: #4b8057;
  color: white;
}
.logo-choice[data-result="incorrect"] .result-stamp {
  background: #bc6166;
  color: white;
  animation-delay: 100ms;
}
.logo-choice:disabled {
  opacity: 1;
}
.answer-area {
  text-align: center;
  min-height: 120px;
  padding-top: 1.3rem;
}
#feedback {
  max-width: 650px;
  margin: 0 auto 0.8rem;
  color: #735347;
  font-size: 0.85rem;
  line-height: 1.5;
}
#feedback:empty {
  margin: 0;
}
#feedback strong {
  display: block;
  color: var(--plum);
  font-size: 1.05rem;
}
#feedback:not(:empty) {
  animation: feedback-rise 350ms ease both;
}
.reveal-detail {
  max-width: 650px;
  margin: -0.3rem auto 1rem;
  font-size: 0.78rem;
  color: #785347;
}
.reveal-detail summary {
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.reveal-detail p {
  line-height: 1.6;
  margin: 0.6rem 0;
}
.reveal-detail a {
  color: var(--plum);
  font-size: 0.7rem;
}
.results {
  text-align: center;
  padding: 2rem 0;
}
.result-medal {
  font-size: 5rem;
  color: #d49830;
  animation: float 5s ease-in-out infinite;
}
#result-copy:empty {
  display: none;
}
.final-scores {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin: 1.5rem 0;
}
.final-score {
  padding: 1rem 1.5rem;
  border: 1px solid #dcc6a6;
  border-radius: 12px;
  background: #fffdf6;
}
.final-score b {
  display: block;
  color: var(--plum);
  font:
    2.3rem Georgia,
    serif;
}
.final-score span {
  font-size: 0.8rem;
}
.review {
  max-width: 700px;
  margin: 2rem auto 0;
  text-align: left;
}
.review summary {
  cursor: pointer;
  color: var(--plum);
  font-size: 0.8rem;
}
.review-row {
  display: flex;
  gap: 1rem;
  padding: 1rem 0;
  border-bottom: 1px solid #e8d8c2;
  font-size: 0.8rem;
  line-height: 1.5;
}
.review-art {
  flex: 0 0 72px;
  width: 72px;
  height: 72px;
}
.review-row b {
  display: block;
  color: var(--plum);
}
.credits {
  font-size: 0.8rem;
  color: var(--muted);
}
.credits summary {
  cursor: pointer;
}
.credits p {
  max-width: 85ch;
}
#art-zoom {
  width: min(1280px, 96vw);
  max-width: 96vw;
  max-height: 94dvh;
  padding: 1.2rem;
  border: 1px solid #dac5ae;
  border-radius: 16px;
  background: #fff8ea;
  color: var(--ink);
  overflow: auto;
}
#art-zoom::backdrop {
  background: #241224d9;
  backdrop-filter: blur(5px);
}
.zoom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  position: sticky;
  top: -1.2rem;
  padding: 0.6rem 0;
  background: #fff8ea;
  z-index: 2;
}
.zoom-bar h2 {
  font:
    1.6rem Georgia,
    serif;
  margin: 0;
}
.zoom-bar button {
  width: 44px;
  height: 44px;
  border: 1px solid #dac5ae;
  border-radius: 50%;
  background: #fffdf8;
  color: var(--plum);
  font-size: 1.2rem;
}
#zoom-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}
.zoom-choice {
  min-width: 0;
  display: grid;
  gap: 0.7rem;
  padding: 0.8rem;
  border: 1px solid #e6d6be;
  border-radius: 12px;
  background: white;
  color: var(--plum);
  text-align: left;
}
